{
  "entities": {
    "CafeSettings": {
      "title": "CafeSettings",
      "description": "Global identity, contact, hero slideshow, floor plan, and reservation policy settings for OneLove Cafe Sigiriya.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "cafeName": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 300 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 60 },
        "whatsapp": { "type": "string", "maxLength": 60 },
        "email": { "type": "string", "maxLength": 140 },
        "instagram": { "type": "string", "maxLength": 120 },
        "coordinates": { "type": "string", "maxLength": 120 },
        "gracePeriodMinutes": { "type": "number" },
        "holdDurationMinutes": { "type": "number" },
        "maxPartySize": { "type": "number" },
        "sameDayCutoffHour": { "type": "number" },
        "bookingPolicy": { "type": "string", "maxLength": 2000 },
        "heroImages": { "type": "array" },
        "heroSlideshowSpeedSeconds": { "type": "number" },
        "floorPlanImageUrl": { "type": "string", "maxLength": 1500 },
        "googleMapsEmbedUrl": { "type": "string", "maxLength": 2500 },
        "mapTitle": { "type": "string", "maxLength": 200 },
        "mapSubtitle": { "type": "string", "maxLength": 500 },
        "menuCurrencyDisplay": { "type": "string", "enum": ["both", "lkr", "usd"] },
        "adminEmails": { "type": "array" }
      },
      "required": ["id", "cafeName"]
    },
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "Food and drink categories for the cafe menu.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 120 },
        "slug": { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "section": { "type": "string", "enum": ["food", "drinks"] },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "slug", "sortOrder", "isActive"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Individual food or beverage dish on the menu.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 160 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "categoryName": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1500 },
        "priceLkr": { "type": "number" },
        "priceUsd": { "type": "number" },
        "priceCurrency": { "type": "string", "enum": ["default", "both", "lkr", "usd"] },
        "imageUrl": { "type": "string", "maxLength": 1500 },
        "dietaryTags": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["id", "name", "categoryId", "categoryName", "priceLkr", "priceUsd", "isFeatured", "isAvailable"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Photography gallery item stored in Cloudflare R2 and indexed in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 800 },
        "imageUrl": { "type": "string", "maxLength": 1500 },
        "aspectRatio": { "type": "string", "enum": ["16:9", "4:3", "3:4", "1:1"] },
        "isFeatured": { "type": "boolean" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "title", "category", "imageUrl", "aspectRatio", "isFeatured", "sortOrder"]
    },
    "CafeEvent": {
      "title": "CafeEvent",
      "description": "Curated event, acoustic evening, or coffee cupping experience.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 180 },
        "subtitle": { "type": "string", "maxLength": 260 },
        "date": { "type": "string", "maxLength": 100 },
        "time": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2500 },
        "imageUrl": { "type": "string", "maxLength": 1500 },
        "priceInfo": { "type": "string", "maxLength": 160 },
        "isFeatured": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "date", "time", "category", "isFeatured", "isActive"]
    },
    "SiteContentSection": {
      "title": "SiteContentSection",
      "description": "Editable copy and Cloudflare R2 image URL for each website section.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "sectionKey": { "type": "string", "maxLength": 80 },
        "kicker": { "type": "string", "maxLength": 200 },
        "heading": { "type": "string", "maxLength": 300 },
        "subheading": { "type": "string", "maxLength": 500 },
        "body": { "type": "string", "maxLength": 4000 },
        "ctaLabel": { "type": "string", "maxLength": 120 },
        "ctaLink": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 1500 }
      },
      "required": ["id", "sectionKey"]
    },
    "SeatingZone": {
      "title": "SeatingZone",
      "description": "Dining zone on the cafe floor plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "atmosphere": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "name", "isActive", "sortOrder"]
    },
    "CafeTable": {
      "title": "CafeTable",
      "description": "Individual reservable table on the interactive floor plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "label": { "type": "string", "maxLength": 60 },
        "number": { "type": "number" },
        "capacity": { "type": "number" },
        "minGuests": { "type": "number" },
        "zoneId": { "type": "string", "maxLength": 100 },
        "zoneName": { "type": "string", "maxLength": 120 },
        "shape": { "type": "string", "enum": ["round", "square", "diamond", "rectangle"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "isVip": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "label", "number", "capacity", "zoneId", "zoneName", "shape", "x", "y", "isActive"]
    },
    "OpeningHoursConfig": {
      "title": "OpeningHoursConfig",
      "description": "Daily service schedule and slot duration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "dayOfWeek": { "type": "string", "maxLength": 30 },
        "isOpen": { "type": "boolean" },
        "openTime": { "type": "string", "maxLength": 20 },
        "closeTime": { "type": "string", "maxLength": 20 },
        "slotDurationMinutes": { "type": "number" },
        "gracePeriodMinutes": { "type": "number" }
      },
      "required": ["id", "dayOfWeek", "isOpen", "openTime", "closeTime"]
    },
    "BlockedDateRecord": {
      "title": "BlockedDateRecord",
      "description": "Special closure or private event blackout date.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 20 },
        "reason": { "type": "string", "maxLength": 300 },
        "isFullDay": { "type": "boolean" },
        "blockedSlots": { "type": "array" }
      },
      "required": ["id", "date", "reason", "isFullDay"]
    },
    "AvailabilitySlotRecord": {
      "title": "AvailabilitySlotRecord",
      "description": "Public table slot lock or reservation status without guest PII.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "tableId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["available", "held", "reserved", "occupied"] },
        "holdExpiresAtMs": { "type": "number" },
        "sessionId": { "type": "string", "maxLength": 100 },
        "referenceCode": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "date", "time", "tableId", "status"]
    },
    "ReservationRecord": {
      "title": "ReservationRecord",
      "description": "Confirmed guest table reservation record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "referenceCode": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "servicePeriod": { "type": "string", "maxLength": 60 },
        "partySize": { "type": "number" },
        "tableId": { "type": "string", "maxLength": 100 },
        "tableLabel": { "type": "string", "maxLength": 60 },
        "zoneId": { "type": "string", "maxLength": 100 },
        "zoneName": { "type": "string", "maxLength": 120 },
        "guestName": { "type": "string", "maxLength": 120 },
        "guestEmail": { "type": "string", "maxLength": 140 },
        "whatsapp": { "type": "string", "maxLength": 60 },
        "country": { "type": "string", "maxLength": 80 },
        "occasion": { "type": "string", "maxLength": 80 },
        "dietaryNotes": { "type": "string", "maxLength": 500 },
        "specialRequests": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["confirmed", "seated", "completed", "cancelled", "rejected", "no_show"] }
      },
      "required": ["id", "referenceCode", "date", "time", "partySize", "tableId", "guestName", "guestEmail", "status"]
    },
    "InquiryRecord": {
      "title": "InquiryRecord",
      "description": "Guest contact and private dining inquiry message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 140 },
        "phone": { "type": "string", "maxLength": 60 },
        "subject": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 2500 },
        "status": { "type": "string", "enum": ["new", "in_progress", "resolved", "archived"] }
      },
      "required": ["id", "name", "email", "message", "status"]
    },
    "SiteImageRecord": {
      "title": "SiteImageRecord",
      "description": "Cloudflare R2 image record for every section and item slot across the website.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "sectionKey": { "type": "string", "maxLength": 100 },
        "label": { "type": "string", "maxLength": 240 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "imageUrls": { "type": "array" },
        "targetCollection": { "type": "string", "maxLength": 100 },
        "targetDocId": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "sectionKey"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator account record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 140 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "manager", "host"] }
      },
      "required": ["id", "email", "name", "role"]
    },
    "AuditLogRecord": {
      "title": "AuditLogRecord",
      "description": "Immutable audit trail record for administrator mutations.",
      "type": "object",
      "properties": {
        "actorEmail": { "type": "string", "maxLength": 140 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "targetCollection": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 120 },
        "summary": { "type": "string", "maxLength": 500 }
      },
      "required": ["actorEmail", "actorUid", "action", "targetCollection", "targetId", "summary"]
    },
    "GlobalSeoConfig": {
      "title": "GlobalSeoConfig",
      "description": "Global SEO, OpenGraph, Schema.org, and brand asset configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "siteName": { "type": "string", "maxLength": 160 },
        "canonicalBaseUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id"]
    },
    "PageSeoConfig": {
      "title": "PageSeoConfig",
      "description": "Per-route SEO metadata configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "routePath": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 240 },
        "description": { "type": "string", "maxLength": 600 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "CafeSettings",
      "description": "Global cafe configuration, authorized admin emails, and hero slideshow settings."
    },
    "/seatingZones/{zoneId}": {
      "schema": "SeatingZone",
      "description": "Dining zones for table reservations."
    },
    "/tables/{tableId}": {
      "schema": "CafeTable",
      "description": "Floor plan tables."
    },
    "/openingHours/{dayId}": {
      "schema": "OpeningHoursConfig",
      "description": "Weekly opening hours schedule."
    },
    "/blockedDates/{blockId}": {
      "schema": "BlockedDateRecord",
      "description": "Blocked dates and closures."
    },
    "/menuCategories/{categoryId}": {
      "schema": "MenuCategory",
      "description": "Food and beverage menu categories."
    },
    "/menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Food and beverage menu items."
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Gallery photographs hosted on Cloudflare R2."
    },
    "/events/{eventId}": {
      "schema": "CafeEvent",
      "description": "Cafe events and experiences."
    },
    "/siteContent/{sectionId}": {
      "schema": "SiteContentSection",
      "description": "Dynamic page copy and Cloudflare R2 section images."
    },
    "/siteImages/{imageId}": {
      "schema": "SiteImageRecord",
      "description": "Dedicated Cloudflare R2 image collection for every website section and item."
    },
    "/seoGlobal/{docId}": {
      "schema": "GlobalSeoConfig",
      "description": "Global SEO and OpenGraph configuration."
    },
    "/seoPages/{pageId}": {
      "schema": "PageSeoConfig",
      "description": "Per-page SEO metadata configuration."
    },
    "/availability/{slotId}": {
      "schema": "AvailabilitySlotRecord",
      "description": "Real-time table availability slots."
    },
    "/reservations/{reservationId}": {
      "schema": "ReservationRecord",
      "description": "Guest table reservations."
    },
    "/inquiries/{inquiryId}": {
      "schema": "InquiryRecord",
      "description": "Guest concierge inquiries."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Authorized administrator directory."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLogRecord",
      "description": "Immutable administrator audit trail."
    }
  }
}
