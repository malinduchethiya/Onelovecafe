rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Core Security Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Check email in token OR Google identity claims so Google OAuth accounts always match
    function isAuthorizedAdminToken() {
      return isSignedIn() && (
        (
          "email" in request.auth.token && (
            request.auth.token.email == "merlinfiverr0@gmail.com" ||
            request.auth.token.email == "onelovecafesigiriya@gmail.com" ||
            request.auth.token.email == "manojmadurangasadaruwan@gmail.com"
          )
        ) ||
        (
          "firebase" in request.auth.token &&
          "identities" in request.auth.token.firebase &&
          "email" in request.auth.token.firebase.identities && (
            "merlinfiverr0@gmail.com" in request.auth.token.firebase.identities.email ||
            "onelovecafesigiriya@gmail.com" in request.auth.token.firebase.identities.email ||
            "manojmadurangasadaruwan@gmail.com" in request.auth.token.firebase.identities.email
          )
        )
      );
    }

    function isListedInSettingsAdmins() {
      return isSignedIn() &&
        "email" in request.auth.token &&
        exists(/databases/$(database)/documents/settings/main) &&
        "adminEmails" in get(/databases/$(database)/documents/settings/main).data &&
        get(/databases/$(database)/documents/settings/main).data.adminEmails is list &&
        request.auth.token.email in get(/databases/$(database)/documents/settings/main).data.adminEmails;
    }

    function isAdmin() {
      return isAuthorizedAdminToken() ||
        isListedInSettingsAdmins() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // 2. Entity Validation Blueprints
    function isValidAdmin(data, uid) {
      return data.keys().hasAll(['id', 'email', 'name', 'role']) &&
        data.id is string && data.id == uid && data.id.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 140 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (data.role == 'super_admin' || data.role == 'manager' || data.role == 'host');
    }

    function isValidSettings(data, settingId) {
      return data.keys().hasAll(['id', 'cafeName']) &&
        data.id is string && data.id == settingId && data.id.size() <= 100 &&
        data.cafeName is string && data.cafeName.size() >= 1 && data.cafeName.size() <= 160;
    }

    function isValidSeatingZone(data, zoneId) {
      return data.keys().hasAll(['id', 'name', 'isActive', 'sortOrder']) &&
        data.id is string && data.id == zoneId && data.id.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.isActive is bool &&
        data.sortOrder is number;
    }

    function isValidTable(data, tableId) {
      return data.keys().hasAll(['id', 'label', 'number', 'capacity', 'zoneId', 'zoneName', 'shape', 'x', 'y', 'isActive']) &&
        data.id is string && data.id == tableId && data.id.size() <= 100 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.number is number &&
        data.capacity is number &&
        data.zoneId is string && data.zoneId.size() <= 100 &&
        data.zoneName is string && data.zoneName.size() <= 160 &&
        data.shape is string && data.shape.size() <= 40 &&
        data.x is number &&
        data.y is number &&
        data.isActive is bool;
    }

    function isValidOpeningHours(data, dayId) {
      return data.keys().hasAll(['id', 'dayOfWeek', 'isOpen', 'openTime', 'closeTime']) &&
        data.id is string && data.id == dayId && data.id.size() <= 100 &&
        data.dayOfWeek is string && data.dayOfWeek.size() <= 40 &&
        data.isOpen is bool &&
        data.openTime is string && data.openTime.size() <= 20 &&
        data.closeTime is string && data.closeTime.size() <= 20;
    }

    function isValidBlockedDate(data, blockId) {
      return data.keys().hasAll(['id', 'date', 'reason', 'isFullDay']) &&
        data.id is string && data.id == blockId && data.id.size() <= 100 &&
        data.date is string && data.date.size() <= 30 &&
        data.reason is string && data.reason.size() <= 400 &&
        data.isFullDay is bool;
    }

    function isValidMenuCategory(data, catId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'sortOrder', 'isActive']) &&
        data.id is string && data.id == catId && data.id.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.slug is string && data.slug.size() <= 160 &&
        data.sortOrder is number &&
        data.isActive is bool;
    }

    function isValidMenuItem(data, itemId) {
      return data.keys().hasAll(['id', 'name', 'categoryId', 'categoryName', 'priceLkr', 'priceUsd', 'isFeatured', 'isAvailable']) &&
        data.id is string && data.id == itemId && data.id.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.categoryId is string && data.categoryId.size() <= 100 &&
        data.categoryName is string && data.categoryName.size() <= 160 &&
        data.priceLkr is number && data.priceLkr >= 0 &&
        data.priceUsd is number && data.priceUsd >= 0 &&
        data.isFeatured is bool &&
        data.isAvailable is bool;
    }

    function isValidGalleryItem(data, galId) {
      return data.keys().hasAll(['id', 'title', 'category', 'imageUrl', 'aspectRatio', 'isFeatured', 'sortOrder']) &&
        data.id is string && data.id == galId && data.id.size() <= 100 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.category is string && data.category.size() <= 100 &&
        data.imageUrl is string && data.imageUrl.size() <= 2000 &&
        data.aspectRatio is string && data.aspectRatio.size() <= 20 &&
        data.isFeatured is bool &&
        data.sortOrder is number;
    }

    function isValidEvent(data, eventId) {
      return data.keys().hasAll(['id', 'title', 'date', 'time', 'category', 'isFeatured', 'isActive']) &&
        data.id is string && data.id == eventId && data.id.size() <= 100 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.date is string && data.date.size() <= 100 &&
        data.time is string && data.time.size() <= 100 &&
        data.category is string && data.category.size() <= 100 &&
        data.isFeatured is bool &&
        data.isActive is bool;
    }

    function isValidSiteContent(data, sectionId) {
      return data.keys().hasAll(['id', 'sectionKey']) &&
        data.id is string && data.id == sectionId && data.id.size() <= 100 &&
        data.sectionKey is string && data.sectionKey.size() <= 100;
    }

    function isValidAvailabilitySlot(data, slotId) {
      return data.keys().hasAll(['id', 'date', 'time', 'tableId', 'status', 'holdExpiresAtMs', 'sessionId', 'referenceCode', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'date', 'time', 'tableId', 'status', 'holdExpiresAtMs', 'sessionId', 'referenceCode', 'updatedAt']) &&
        data.id is string && data.id == slotId && data.id.size() <= 128 &&
        data.date is string && data.date.size() == 10 &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 12 &&
        data.tableId is string && data.tableId.size() >= 1 && data.tableId.size() <= 80 &&
        (data.status == 'available' || data.status == 'held' || data.status == 'reserved' || data.status == 'occupied') &&
        data.holdExpiresAtMs is number && data.holdExpiresAtMs >= 0 &&
        data.sessionId is string && data.sessionId.size() <= 100 &&
        data.referenceCode is string && data.referenceCode.size() <= 30 &&
        data.updatedAt == request.time;
    }

    function isValidReservation(data, resId) {
      return data.keys().hasAll(['id', 'referenceCode', 'date', 'time', 'servicePeriod', 'partySize', 'tableId', 'tableLabel', 'zoneId', 'zoneName', 'guestName', 'guestEmail', 'whatsapp', 'country', 'occasion', 'dietaryNotes', 'specialRequests', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'referenceCode', 'date', 'time', 'servicePeriod', 'partySize', 'tableId', 'tableLabel', 'zoneId', 'zoneName', 'guestName', 'guestEmail', 'whatsapp', 'country', 'occasion', 'dietaryNotes', 'specialRequests', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == resId && data.id.size() <= 100 &&
        data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 30 &&
        data.date is string && data.date.size() == 10 &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 12 &&
        data.servicePeriod is string && data.servicePeriod.size() <= 60 &&
        data.partySize is number && data.partySize >= 1 && data.partySize <= 30 &&
        data.tableId is string && data.tableId.size() <= 80 &&
        data.tableLabel is string && data.tableLabel.size() <= 80 &&
        data.zoneId is string && data.zoneId.size() <= 80 &&
        data.zoneName is string && data.zoneName.size() <= 120 &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 120 &&
        data.guestEmail is string && data.guestEmail.size() >= 3 && data.guestEmail.size() <= 140 &&
        data.whatsapp is string && data.whatsapp.size() <= 60 &&
        data.country is string && data.country.size() <= 80 &&
        data.occasion is string && data.occasion.size() <= 80 &&
        data.dietaryNotes is string && data.dietaryNotes.size() <= 500 &&
        data.specialRequests is string && data.specialRequests.size() <= 1000 &&
        (data.status == 'confirmed' || data.status == 'seated' || data.status == 'completed' || data.status == 'cancelled' || data.status == 'rejected' || data.status == 'no_show') &&
        data.updatedAt == request.time;
    }

    function isValidInquiry(data, inqId) {
      return data.keys().hasAll(['id', 'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == inqId && data.id.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 140 &&
        data.phone is string && data.phone.size() <= 60 &&
        data.subject is string && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2500 &&
        (data.status == 'new' || data.status == 'in_progress' || data.status == 'resolved' || data.status == 'archived') &&
        data.updatedAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorEmail', 'actorUid', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorEmail', 'actorUid', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt']) &&
        data.actorEmail is string && data.actorEmail.size() <= 140 &&
        data.actorUid is string && data.actorUid.size() <= 128 &&
        data.action is string && data.action.size() <= 100 &&
        data.targetCollection is string && data.targetCollection.size() <= 80 &&
        data.targetId is string && data.targetId.size() <= 120 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.createdAt == request.time;
    }

    // 3. Collection Match Blocks
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isValidAdmin(incoming(), adminId) && isAdmin();
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSettings(incoming(), settingId);
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /seatingZones/{zoneId} {
      allow get, list: if true;
      allow create, update: if isValidId(zoneId) && isAdmin() && isValidSeatingZone(incoming(), zoneId);
      allow delete: if isValidId(zoneId) && isAdmin();
    }

    match /tables/{tableId} {
      allow get, list: if true;
      allow create, update: if isValidId(tableId) && isAdmin() && isValidTable(incoming(), tableId);
      allow delete: if isValidId(tableId) && isAdmin();
    }

    match /openingHours/{dayId} {
      allow get, list: if true;
      allow create, update: if isValidId(dayId) && isAdmin() && isValidOpeningHours(incoming(), dayId);
      allow delete: if isValidId(dayId) && isAdmin();
    }

    match /blockedDates/{blockId} {
      allow get, list: if true;
      allow create, update: if isValidId(blockId) && isAdmin() && isValidBlockedDate(incoming(), blockId);
      allow delete: if isValidId(blockId) && isAdmin();
    }

    match /menuCategories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidMenuCategory(incoming(), categoryId);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /menuItems/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId) && isAdmin() && isValidMenuItem(incoming(), itemId);
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /gallery/{galleryId} {
      allow get, list: if true;
      allow create, update: if isValidId(galleryId) && isAdmin() && isValidGalleryItem(incoming(), galleryId);
      allow delete: if isValidId(galleryId) && isAdmin();
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow create, update: if isValidId(eventId) && isAdmin() && isValidEvent(incoming(), eventId);
      allow delete: if isValidId(eventId) && isAdmin();
    }

    match /siteContent/{sectionId} {
      allow get, list: if true;
      allow create, update: if isValidId(sectionId) && isAdmin() && isValidSiteContent(incoming(), sectionId);
      allow delete: if isValidId(sectionId) && isAdmin();
    }

    match /siteImages/{imageId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(imageId) && isAdmin();
    }

    match /seoGlobal/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId) && isAdmin();
    }

    match /seoPages/{pageId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(pageId) && isAdmin();
    }

    match /availability/{slotId} {
      allow get, list: if true;
      allow create: if isValidId(slotId) && isValidAvailabilitySlot(incoming(), slotId);
      allow update: if isValidId(slotId) && isValidAvailabilitySlot(incoming(), slotId) && (
        isAdmin() ||
        existing().status == 'available' ||
        existing().status == 'held'
      );
      allow delete: if isValidId(slotId) && isAdmin();
    }

    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId);
      allow list: if isAdmin();
      allow create: if isValidId(reservationId) && isValidReservation(incoming(), reservationId) &&
        incoming().status == 'confirmed' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(reservationId) && isValidReservation(incoming(), reservationId) && isAdmin();
      allow delete: if isValidId(reservationId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming(), inquiryId) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(inquiryId) && isValidInquiry(incoming(), inquiryId) && isAdmin();
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
