rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'merlinfiverr0@gmail.com' ||
        request.auth.token.email == 'onelovecafesigiriya@gmail.com' ||
        request.auth.token.email == 'Onelovecafesigiriya@gmail.com' ||
        request.auth.token.email.matches('(?i)^(merlinfiverr0|onelovecafesigiriya)@gmail\\.com$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation Blueprints (Pillar 2) — Base64 images supported up to 900KB
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'name', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role in ['super_admin', 'manager', 'host'] &&
        data.createdAt is timestamp;
    }

    function isValidReservation(data) {
      return data.keys().hasAll([
          'referenceCode', 'date', 'time', 'servicePeriod', 'partySize',
          'tableId', 'tableLabel', 'zoneId', 'zoneName',
          'guestName', 'guestEmail', 'whatsapp', 'country',
          'occasion', 'dietaryNotes', 'specialRequests',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'referenceCode', 'date', 'time', 'servicePeriod', 'partySize',
          'tableId', 'tableLabel', 'zoneId', 'zoneName',
          'guestName', 'guestEmail', 'whatsapp', 'country',
          'occasion', 'dietaryNotes', 'specialRequests',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 24 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
        data.servicePeriod is string && data.servicePeriod.size() <= 40 &&
        data.partySize is int && data.partySize >= 1 && data.partySize <= 20 &&
        data.tableId is string && data.tableId.size() >= 1 && data.tableId.size() <= 40 &&
        data.tableLabel is string && data.tableLabel.size() >= 1 && data.tableLabel.size() <= 40 &&
        data.zoneId is string && data.zoneId.size() >= 1 && data.zoneId.size() <= 40 &&
        data.zoneName is string && data.zoneName.size() >= 1 && data.zoneName.size() <= 60 &&
        data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 100 &&
        data.guestEmail is string && data.guestEmail.size() >= 3 && data.guestEmail.size() <= 120 &&
        data.whatsapp is string && data.whatsapp.size() >= 5 && data.whatsapp.size() <= 30 &&
        data.country is string && data.country.size() >= 2 && data.country.size() <= 80 &&
        data.occasion is string && data.occasion.size() <= 60 &&
        data.dietaryNotes is string && data.dietaryNotes.size() <= 500 &&
        data.specialRequests is string && data.specialRequests.size() <= 500 &&
        data.status in ['confirmed', 'seated', 'completed', 'cancelled', 'rejected', 'no_show'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReservationHold(data) {
      return data.keys().hasAll(['slotId', 'date', 'time', 'tableId', 'sessionId', 'expiresAtMs', 'createdAt']) &&
        data.keys().hasOnly(['slotId', 'date', 'time', 'tableId', 'sessionId', 'expiresAtMs', 'createdAt']) &&
        data.slotId is string && data.slotId.size() >= 5 && data.slotId.size() <= 80 &&
        data.date is string && data.date.size() == 10 &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
        data.tableId is string && data.tableId.size() >= 1 && data.tableId.size() <= 40 &&
        data.sessionId is string && data.sessionId.size() >= 4 && data.sessionId.size() <= 80 &&
        data.expiresAtMs is int && data.expiresAtMs > 0 &&
        data.createdAt is timestamp;
    }

    function isValidAvailabilitySlot(data) {
      return data.keys().hasAll(['date', 'time', 'tableId', 'status', 'holdExpiresAtMs', 'sessionId', 'referenceCode', 'updatedAt']) &&
        data.keys().hasOnly(['date', 'time', 'tableId', 'status', 'holdExpiresAtMs', 'sessionId', 'referenceCode', 'updatedAt']) &&
        data.date is string && data.date.size() == 10 &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
        data.tableId is string && data.tableId.size() >= 1 && data.tableId.size() <= 40 &&
        data.status in ['available', 'held', 'reserved', 'occupied'] &&
        data.holdExpiresAtMs is int &&
        data.sessionId is string && data.sessionId.size() <= 80 &&
        data.referenceCode is string && data.referenceCode.size() <= 24 &&
        data.updatedAt is timestamp;
    }

    function isValidTable(data) {
      return data.keys().hasAll(['label', 'number', 'capacity', 'minGuests', 'zoneId', 'zoneName', 'shape', 'x', 'y', 'isVip', 'isActive', 'notes', 'updatedAt']) &&
        data.keys().hasOnly(['label', 'number', 'capacity', 'minGuests', 'zoneId', 'zoneName', 'shape', 'x', 'y', 'isVip', 'isActive', 'notes', 'updatedAt']) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 30 &&
        data.number is int && data.number >= 1 && data.number <= 200 &&
        data.capacity is int && data.capacity >= 1 && data.capacity <= 24 &&
        data.minGuests is int && data.minGuests >= 1 && data.minGuests <= 24 &&
        data.zoneId is string && data.zoneId.size() >= 1 && data.zoneId.size() <= 40 &&
        data.zoneName is string && data.zoneName.size() >= 1 && data.zoneName.size() <= 60 &&
        data.shape in ['round', 'square', 'diamond', 'rectangle'] &&
        data.x is number && data.x >= 0 && data.x <= 100 &&
        data.y is number && data.y >= 0 && data.y <= 100 &&
        data.isVip is bool &&
        data.isActive is bool &&
        data.notes is string && data.notes.size() <= 200 &&
        data.updatedAt is timestamp;
    }

    function isValidSeatingZone(data) {
      return data.keys().hasAll(['name', 'subtitle', 'description', 'atmosphere', 'isActive', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'subtitle', 'description', 'atmosphere', 'isActive', 'sortOrder', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.subtitle is string && data.subtitle.size() <= 120 &&
        data.description is string && data.description.size() <= 300 &&
        data.atmosphere is string && data.atmosphere.size() <= 100 &&
        data.isActive is bool &&
        data.sortOrder is int &&
        data.updatedAt is timestamp;
    }

    function isValidOpeningHours(data) {
      return data.keys().hasAll(['dayOfWeek', 'isOpen', 'openTime', 'closeTime', 'slotDurationMinutes', 'gracePeriodMinutes', 'updatedAt']) &&
        data.keys().hasOnly(['dayOfWeek', 'isOpen', 'openTime', 'closeTime', 'slotDurationMinutes', 'gracePeriodMinutes', 'updatedAt']) &&
        data.dayOfWeek is string && data.dayOfWeek.size() >= 3 && data.dayOfWeek.size() <= 20 &&
        data.isOpen is bool &&
        data.openTime is string && data.openTime.size() <= 10 &&
        data.closeTime is string && data.closeTime.size() <= 10 &&
        data.slotDurationMinutes is int && data.slotDurationMinutes >= 15 && data.slotDurationMinutes <= 240 &&
        data.gracePeriodMinutes is int && data.gracePeriodMinutes >= 5 && data.gracePeriodMinutes <= 60 &&
        data.updatedAt is timestamp;
    }

    function isValidBlockedDate(data) {
      return data.keys().hasAll(['date', 'reason', 'isFullDay', 'blockedSlots', 'createdAt']) &&
        data.keys().hasOnly(['date', 'reason', 'isFullDay', 'blockedSlots', 'createdAt']) &&
        data.date is string && data.date.size() == 10 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 160 &&
        data.isFullDay is bool &&
        data.blockedSlots is list && data.blockedSlots.size() <= 30 &&
        (data.blockedSlots.size() == 0 || data.blockedSlots[0] is string) &&
        data.createdAt is timestamp;
    }

    function isValidMenuCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'subtitle', 'sortOrder', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'slug', 'subtitle', 'sortOrder', 'isActive', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 &&
        data.subtitle is string && data.subtitle.size() <= 140 &&
        data.sortOrder is int &&
        data.isActive is bool &&
        data.updatedAt is timestamp;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'categoryId', 'categoryName', 'description', 'priceLkr', 'priceUsd', 'imageUrl', 'dietaryTags', 'isFeatured', 'isAvailable', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'categoryId', 'categoryName', 'description', 'priceLkr', 'priceUsd', 'priceCurrency', 'imageUrl', 'dietaryTags', 'isFeatured', 'isAvailable', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 400 &&
        data.priceLkr is number && data.priceLkr >= 0 &&
        data.priceUsd is number && data.priceUsd >= 0 &&
        (!('priceCurrency' in data) || (data.priceCurrency in ['default', 'both', 'lkr', 'usd'])) &&
        data.imageUrl is string && data.imageUrl.size() <= 900000 &&
        data.dietaryTags is list && data.dietaryTags.size() <= 10 &&
        (data.dietaryTags.size() == 0 || data.dietaryTags[0] is string) &&
        data.isFeatured is bool &&
        data.isAvailable is bool &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'category', 'caption', 'imageUrl', 'aspectRatio', 'isFeatured', 'sortOrder', 'createdAt']) &&
        data.keys().hasOnly(['title', 'category', 'caption', 'imageUrl', 'aspectRatio', 'isFeatured', 'sortOrder', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.category in ['Architecture', 'Culinary', 'Coffee & Botanicals', 'Evening Sanctuary', 'Sigiriya Surroundings'] &&
        data.caption is string && data.caption.size() <= 300 &&
        data.imageUrl is string && data.imageUrl.size() <= 900000 &&
        data.aspectRatio in ['16:9', '4:3', '3:4', '1:1'] &&
        data.isFeatured is bool &&
        data.sortOrder is int &&
        data.createdAt is timestamp;
    }

    function isValidCafeEvent(data) {
      return data.keys().hasAll(['title', 'subtitle', 'date', 'time', 'category', 'description', 'imageUrl', 'priceInfo', 'isFeatured', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'subtitle', 'date', 'time', 'category', 'description', 'imageUrl', 'priceInfo', 'isFeatured', 'isActive', 'updatedAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() <= 140 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 40 &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 40 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
        data.imageUrl is string && data.imageUrl.size() <= 900000 &&
        data.priceInfo is string && data.priceInfo.size() <= 80 &&
        data.isFeatured is bool &&
        data.isActive is bool &&
        data.updatedAt is timestamp;
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll(['sectionKey', 'kicker', 'heading', 'subheading', 'body', 'ctaLabel', 'ctaLink', 'imageUrl', 'updatedAt']) &&
        data.keys().hasOnly(['sectionKey', 'kicker', 'heading', 'subheading', 'body', 'ctaLabel', 'ctaLink', 'imageUrl', 'updatedAt']) &&
        data.sectionKey is string && data.sectionKey.size() >= 1 && data.sectionKey.size() <= 60 &&
        data.kicker is string && data.kicker.size() <= 100 &&
        data.heading is string && data.heading.size() >= 1 && data.heading.size() <= 160 &&
        data.subheading is string && data.subheading.size() <= 400 &&
        data.body is string && data.body.size() <= 1200 &&
        data.ctaLabel is string && data.ctaLabel.size() <= 60 &&
        data.ctaLink is string && data.ctaLink.size() <= 120 &&
        data.imageUrl is string && data.imageUrl.size() <= 900000 &&
        data.updatedAt is timestamp;
    }

    function isValidCafeSettings(data) {
      return data.keys().hasAll([
          'cafeName', 'tagline', 'address', 'phone', 'whatsapp', 'email',
          'instagram', 'coordinates', 'gracePeriodMinutes', 'holdDurationMinutes',
          'maxPartySize', 'sameDayCutoffHour', 'bookingPolicy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'cafeName', 'tagline', 'address', 'phone', 'whatsapp', 'email',
          'instagram', 'coordinates', 'gracePeriodMinutes', 'holdDurationMinutes',
          'maxPartySize', 'sameDayCutoffHour', 'bookingPolicy',
          'heroImages', 'heroSlideshowSpeedSeconds', 'floorPlanImageUrl',
          'googleMapsEmbedUrl', 'mapTitle', 'mapSubtitle', 'menuCurrencyDisplay', 'updatedAt'
        ]) &&
        data.cafeName is string && data.cafeName.size() >= 1 && data.cafeName.size() <= 80 &&
        data.tagline is string && data.tagline.size() <= 160 &&
        data.address is string && data.address.size() <= 200 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.whatsapp is string && data.whatsapp.size() <= 40 &&
        data.email is string && data.email.size() <= 120 &&
        data.instagram is string && data.instagram.size() <= 100 &&
        data.coordinates is string && data.coordinates.size() <= 60 &&
        data.gracePeriodMinutes is int && data.gracePeriodMinutes >= 5 && data.gracePeriodMinutes <= 60 &&
        data.holdDurationMinutes is int && data.holdDurationMinutes >= 3 && data.holdDurationMinutes <= 30 &&
        data.maxPartySize is int && data.maxPartySize >= 2 && data.maxPartySize <= 30 &&
        data.sameDayCutoffHour is int && data.sameDayCutoffHour >= 0 && data.sameDayCutoffHour <= 23 &&
        data.bookingPolicy is string && data.bookingPolicy.size() <= 600 &&
        (!('heroImages' in data) || (data.heroImages is list && data.heroImages.size() <= 12 && (data.heroImages.size() == 0 || data.heroImages[0] is string))) &&
        (!('heroSlideshowSpeedSeconds' in data) || (data.heroSlideshowSpeedSeconds is number && data.heroSlideshowSpeedSeconds >= 1 && data.heroSlideshowSpeedSeconds <= 60)) &&
        (!('floorPlanImageUrl' in data) || (data.floorPlanImageUrl is string && data.floorPlanImageUrl.size() <= 900000)) &&
        (!('googleMapsEmbedUrl' in data) || (data.googleMapsEmbedUrl is string && data.googleMapsEmbedUrl.size() <= 2000)) &&
        (!('mapTitle' in data) || (data.mapTitle is string && data.mapTitle.size() <= 120)) &&
        (!('mapSubtitle' in data) || (data.mapSubtitle is string && data.mapSubtitle.size() <= 250)) &&
        (!('menuCurrencyDisplay' in data) || (data.menuCurrencyDisplay in ['both', 'lkr', 'usd'])) &&
        data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1000 &&
        data.status in ['new', 'in_progress', 'resolved', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorEmail', 'actorUid', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorEmail', 'actorUid', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt']) &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 120 &&
        data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 80 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.targetCollection is string && data.targetCollection.size() >= 1 && data.targetCollection.size() <= 60 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 80 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
        data.createdAt is timestamp;
    }

    function isValidSeoConfig(data) {
      return data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 100 &&
        data.defaultTitle is string && data.defaultTitle.size() >= 1 && data.defaultTitle.size() <= 160 &&
        data.defaultDescription is string && data.defaultDescription.size() <= 500 &&
        data.canonicalDomain is string && data.canonicalDomain.size() <= 200 &&
        data.updatedAt is timestamp;
    }

    function isValidSeoPage(data) {
      return data.routePath is string && data.routePath.size() >= 1 && data.routePath.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.metaDescription is string && data.metaDescription.size() <= 500 &&
        data.canonicalPath is string && data.canonicalPath.size() <= 120 &&
        data.indexable is bool &&
        data.updatedAt is timestamp;
    }

    // 1. Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isValidAdmin(incoming()) && incoming().createdAt == request.time && isAdmin();
      allow update: if isValidId(adminId) && isValidAdmin(incoming()) && incoming().createdAt == existing().createdAt && isAdmin();
      allow delete: if isValidId(adminId) && isAdmin();
    }

    // 2. Reservations Collection (Synced with OneLove Café Admin Mobile Companion App)
    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId);
      allow list: if true;
      allow create: if isValidId(reservationId) &&
        isValidReservation(incoming()) &&
        (incoming().status == 'confirmed' || isAdmin());
      allow update: if isValidId(reservationId) && (
        isAdmin() ||
        (
          incoming().status in ['confirmed', 'seated', 'completed', 'cancelled', 'rejected', 'no_show'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(reservationId) && isAdmin();
    }

    // 3. Reservation Holds Collection (Non-PII Ephemeral Holds)
    match /reservationHolds/{holdId} {
      allow get: if isValidId(holdId);
      allow list: if true;
      allow create: if isValidId(holdId) &&
        isValidReservationHold(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(holdId) &&
        isValidReservationHold(incoming()) &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(holdId);
    }

    // 4. Availability Slots Collection (Non-PII Public Floor Plan State)
    match /availability/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if true;
      allow create: if isValidId(slotId) &&
        isValidAvailabilitySlot(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(slotId) &&
        isValidAvailabilitySlot(incoming()) &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          existing().status == 'available' ||
          existing().status == 'held' ||
          incoming().status == 'available'
        );
      allow delete: if isValidId(slotId) && (isAdmin() || existing().status == 'available' || existing().status == 'held');
    }

    // 5. Tables Collection
    match /tables/{tableId} {
      allow get: if isValidId(tableId);
      allow list: if true;
      allow create: if isValidId(tableId) && isValidTable(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(tableId) && isValidTable(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(tableId) && isAdmin();
    }

    // 6. Seating Zones Collection
    match /seatingZones/{zoneId} {
      allow get: if isValidId(zoneId);
      allow list: if true;
      allow create: if isValidId(zoneId) && isValidSeatingZone(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(zoneId) && isValidSeatingZone(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(zoneId) && isAdmin();
    }

    // 7. Opening Hours Collection
    match /openingHours/{dayId} {
      allow get: if isValidId(dayId);
      allow list: if true;
      allow create: if isValidId(dayId) && isValidOpeningHours(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(dayId) && isValidOpeningHours(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(dayId) && isAdmin();
    }

    // 8. Blocked Dates Collection
    match /blockedDates/{dateId} {
      allow get: if isValidId(dateId);
      allow list: if true;
      allow create: if isValidId(dateId) && isValidBlockedDate(incoming()) && incoming().createdAt == request.time && isAdmin();
      allow update: if isValidId(dateId) && isValidBlockedDate(incoming()) && incoming().createdAt == existing().createdAt && isAdmin();
      allow delete: if isValidId(dateId) && isAdmin();
    }

    // 9. Menu Categories Collection
    match /menuCategories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) && isValidMenuCategory(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(categoryId) && isValidMenuCategory(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 10. Menu Items Collection
    match /menuItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isValidMenuItem(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(itemId) && isValidMenuItem(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // 11. Gallery Collection
    match /gallery/{imageId} {
      allow get: if isValidId(imageId);
      allow list: if true;
      allow create: if isValidId(imageId) && isValidGalleryItem(incoming()) && incoming().createdAt == request.time && isAdmin();
      allow update: if isValidId(imageId) && isValidGalleryItem(incoming()) && incoming().createdAt == existing().createdAt && isAdmin();
      allow delete: if isValidId(imageId) && isAdmin();
    }

    // 12. Events Collection
    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create: if isValidId(eventId) && isValidCafeEvent(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(eventId) && isValidCafeEvent(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // 13. Site Content Collection
    match /siteContent/{sectionId} {
      allow get: if isValidId(sectionId);
      allow list: if true;
      allow create: if isValidId(sectionId) && isValidSiteContent(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(sectionId) && isValidSiteContent(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(sectionId) && isAdmin();
    }

    // 14. Settings Collection
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isValidId(settingId) && isValidCafeSettings(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow update: if isValidId(settingId) && isValidCafeSettings(incoming()) && incoming().updatedAt == request.time && isAdmin();
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 15. Inquiries Collection (PII Isolated to Admins after Creation)
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 16. Audit Logs Collection (Immutable Admin Trail)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update, delete: if false;
    }

    // 17. Global SEO Configuration Collection
    match /seoConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create: if isValidId(configId) && isValidSeoConfig(incoming()) && isAdmin();
      allow update: if isValidId(configId) && isValidSeoConfig(incoming()) && isAdmin();
      allow delete: if isValidId(configId) && isAdmin();
    }

    // 18. Per-Page SEO Configuration Collection
    match /seoPages/{pageId} {
      allow get: if isValidId(pageId);
      allow list: if true;
      allow create: if isValidId(pageId) && isValidSeoPage(incoming()) && isAdmin();
      allow update: if isValidId(pageId) && isValidSeoPage(incoming()) && isAdmin();
      allow delete: if isValidId(pageId) && isAdmin();
    }
  }
}