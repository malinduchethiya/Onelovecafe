{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onelove-cafe-sigiriya",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_PUBLIC_URL": "https://cdn.onelovecafesigiriya.com",
    "R2_BUCKET_NAME": "onelove-assets"
  }
}
