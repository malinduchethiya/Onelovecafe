# GEMINI_API_KEY: Optional server-side key if AI concierge features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical base URL for OpenGraph, sitemap.xml, and QR code links
APP_URL="https://onelovecafe.lk"

# FIREBASE CLIENT CONFIGURATION (Loaded automatically from firebase-applet-config.json or VITE_ vars)
VITE_FIREBASE_PROJECT_ID="advance-sandbox-gmzf6"
VITE_FIREBASE_DATABASE_ID="ai-studio-5fe42b00-de17-4d88-b455-9367f3431665"
VITE_ADMIN_BOOTSTRAP_EMAIL="merlinfiverr0@gmail.com"

# CLOUDFLARE R2 / S3-COMPATIBLE OBJECT STORAGE (Zero Egress Image Storage)
# Option A: Cloudflare R2 credentials (from Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="onelove-assets"
# Public URL for the bucket (e.g., https://pub-xxxxxx.r2.dev or custom domain https://cdn.onelovecafesigiriya.com)
R2_PUBLIC_URL=""

# Option B: Standard S3 API credentials (AWS S3, Wasabi, MinIO, or custom S3 provider)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="onelove-assets"
S3_PUBLIC_URL=""
S3_REGION="auto"
